<p class="text-sm text-base-content/70 mb-4 native:hidden">Everything you're responsible for this period: your recurring duties and one-off assignments.</p>

<%# Up top, so a mistaken tick is easy to find and undo %>
<% if @completed_tasks.any? %>
  <section id="recently-completed" class="mb-4">
    <details>
      <summary class="font-semibold mb-2 cursor-pointer native:text-sm native:font-medium native:text-base-content/60 native:px-1">Recently completed <span class="text-base-content/65 text-sm font-normal ml-1"><%= @completed_tasks.size %></span></summary>
      <div class="<%= task_list_classes %>">
        <% @completed_tasks.each do |task| %>
          <%= render "tasks/completed_row", task: task, return_to: tasks_path(tab: "my") %>
        <% end %>
      </div>
    </details>
  </section>
<% end %>

<section id="my-work" class="mb-6">
  <h2 class="font-semibold mb-2 native:text-sm native:font-medium native:text-base-content/60 native:px-1">Your tasks <span class="text-base-content/65 text-sm font-normal ml-1"><%= @my_tasks.size %></span></h2>
  <div class="<%= task_list_classes %>">
    <% @my_tasks.each do |task| %>
      <%= render "tasks/work_card", task: task, action: (task.recurring? ? :release : nil), return_tab: "my" %>
    <% end %>
    <% if @my_tasks.empty? %>
      <p class="text-sm text-base-content/65 px-3 py-3 sm:p-0">
        Nothing on your list right now.
        <%= link_to "See what's open", tasks_path(tab: "available"), class: "link text-primary-ink", data: { turbo_frame: "tasks_content" } %>
      </p>
    <% end %>
  </div>
</section>

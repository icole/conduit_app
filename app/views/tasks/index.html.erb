<div data-controller="tasks" class="<%= hotwire_native_app? ? '' : '-mx-2 sm:mx-0 px-2 sm:px-0' %>">
  <!-- Header -->
  <div class="flex justify-between items-start gap-2 <%= hotwire_native_app? ? 'mb-2 px-1' : 'mb-4' %>">
    <div>
      <h1 class="<%= hotwire_native_app? ? 'text-lg font-semibold' : 'text-xl sm:text-2xl font-bold' %>">Tasks</h1>
      <p class="text-sm text-base-content/60"><%= current_community.name %></p>
    </div>
    <button class="<%= hotwire_native_app? ? 'btn btn-primary btn-sm gap-1' : 'btn btn-primary btn-sm sm:btn-md' %>" data-action="click->tasks#showForm" title="Add Task">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
      </svg>
      <span>Add Task</span>
    </button>
  </div>

  <!-- New task form -->
  <div id="new-task-form" class="<%= 'hidden' unless @task&.errors&.any? %> <%= hotwire_native_app? ? 'mb-2' : 'mb-6' %>">
    <div class="card bg-base-100 border border-base-300 rounded-lg p-4">
      <%= turbo_frame_tag "new_task" do %>
        <%= render "tasks/form", task: Task.new %>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "tasks_content" do %>
    <%= render "tasks/tabs" %>

    <% if turbo_frame_request? %>
      <% if flash[:notice] %><div class="alert alert-success alert-soft py-2 text-sm mb-3" role="status"><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="alert alert-error alert-soft py-2 text-sm mb-3" role="alert"><%= flash[:alert] %></div><% end %>
    <% end %>

    <% if @current_view %>
      <%= render "tasks/board" %>
    <% else %>
      <% if @tab == "available" %>
        <%= render "tasks/tabs/available" %>
      <% elsif @tab == "coverage" %>
        <%= render "tasks/tabs/coverage" %>
      <% else %>
        <%= render "tasks/tabs/my" %>
      <% end %>
    <% end %>
  <% end %>
</div>

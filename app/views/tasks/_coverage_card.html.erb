<% gaps = workstream.recurring_tasks.count { |r| !r.covered? } %>
<%= link_to workstream_path(workstream), id: dom_id(workstream), data: { turbo_frame: "_top" },
      class: "card bg-base-100 border border-base-200 border-l-4 #{workstream_accent_class(workstream)} hover:border-base-300 transition-colors" do %>
  <div class="card-body p-4 gap-2">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold"><%= workstream.name %></h3>
      <% if workstream.covered? %>
        <span class="badge badge-sm badge-outline badge-success whitespace-nowrap">Covered</span>
      <% else %>
        <span class="badge badge-sm badge-error whitespace-nowrap">Needs owner</span>
      <% end %>
    </div>
    <% if workstream.description.present? %>
      <p class="text-sm text-base-content/70"><%= workstream.description %></p>
    <% end %>
    <% if gaps.positive? %>
      <p class="text-xs text-base-content/60"><%= pluralize(gaps, "recurring task") %> without a responsible person</p>
    <% end %>
    <%# Always the card's last line, so it lines up across the grid. Stacked on
        phones, one line with a separator on wider screens, whatever the length. %>
    <div class="flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-2 text-sm mt-auto pt-1">
      <span data-coverage-type><%= workstream_type_badge(workstream) %></span>
      <span class="hidden sm:inline text-base-content/30" aria-hidden="true">•</span>
      <% if workstream.owner %>
        <span data-coverage-owner class="text-base-content/60">Owner: <%= workstream.owner.name %></span>
      <% else %>
        <span data-coverage-owner class="text-error">No owner assigned</span>
      <% end %>
    </div>
  </div>
<% end %>

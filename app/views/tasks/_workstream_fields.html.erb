<%# Every task rolls up to a workstream. Closed projects take no new work. %>
<% workstreams = Workstream.open.or(Workstream.where(id: task.workstream_id)).by_priority %>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4">
  <div class="form-control w-full mb-4">
    <%= form.label :workstream_id, "Workstream", class: "label" %>
    <% if workstreams.any? %>
      <%= form.select :workstream_id,
            workstreams.group_by(&:type_label).transform_values { |ws| ws.map { |w| [ w.name, w.id ] } },
            { prompt: "Choose a workstream…" },
            class: "select select-bordered w-full", required: true %>
    <% else %>
      <p class="text-sm text-base-content/70">There are no workstreams yet. An admin needs to set them up before tasks can be added.</p>
    <% end %>
  </div>

  <div class="form-control w-full mb-4">
    <%= form.label :effort, "Estimated effort", class: "label" %>
    <%= form.select :effort, EstimatedEffort::SIZES.keys, { include_blank: "Not estimated" }, class: "select select-bordered w-full" %>
  </div>
</div>

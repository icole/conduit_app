<%# How many people a task needs (meeting facilitation takes two), and a
    picker for each. Spots past "People needed" are hidden and cleared.
    locals: scope ("task" / "recurring_task"), ids_field, people_needed, selected (users),
            users, first_label, blank_label, label_target (relabelled by task-repeat) %>
<% max_people = 4 %>
<% needed = people_needed.to_i.clamp(1, max_people) %>
<% later_labels = [ "Second person", "Third person", "Fourth person" ] %>
<div data-controller="people-slots">
  <div class="form-control w-full mb-4">
    <%= label_tag "#{scope}_people_needed", "People needed", class: "label" %>
    <%= select_tag "#{scope}[people_needed]",
          options_for_select((1..max_people).map { |n| [ n == 1 ? "1 person" : "#{n} people", n ] }, needed),
          id: "#{scope}_people_needed", class: "select select-bordered w-full",
          data: { people_slots_target: "count", action: "change->people-slots#update" } %>
  </div>

  <% max_people.times do |i| %>
    <div data-people-slots-target="slot" <%= "hidden" if i >= needed %>>
      <%= render "tasks/user_select", name: "#{scope}[#{ids_field}][]", id: "#{scope}_#{ids_field}_#{i}",
                 label: i.zero? ? first_label : later_labels[i - 1], selected: selected[i], users: users,
                 blank_label: local_assigns.fetch(:blank_label, "Unassigned"),
                 label_data: (i.zero? && local_assigns[:label_target] ? { task_repeat_target: "assigneeLabel" } : {}) %>
    </div>
  <% end %>
</div>

<%= turbo_stream.remove dom_id(@task) %>
<%= turbo_stream.update "flash", partial: "layouts/flash_messages" %>
<%= turbo_stream.update "undo-notification-container", partial: "layouts/undo_notification" %>
<% if @task.workstream %>
  <%= turbo_stream.update "open-work-count", @task.workstream.tasks.open.count.to_s %>
<% end %>

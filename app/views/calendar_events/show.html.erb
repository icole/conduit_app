<div class="container mx-auto max-w-6xl px-4 py-8">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <h1 class="text-3xl font-bold"><%= @event.title %></h1>
    <div class="flex flex-wrap gap-2">
      <%= link_to calendar_index_path, class: "btn btn-outline btn-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
        </svg>
        Back
      <% end %>

      <%= link_to edit_calendar_event_path(google_event_id: @event.google_event_id), class: "btn btn-primary btn-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit
      <% end %>

      <%= button_to calendar_event_path(google_event_id: @event.google_event_id), method: :delete,
                    class: "btn btn-error btn-outline btn-sm",
                    title: "Delete Event",
                    form: { data: { turbo_confirm: 'Are you sure you want to delete this event from Google Calendar?' } } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Event Details Card -->
  <div class="card bg-base-100 shadow-xl mb-12">
    <div class="card-body">
      <h2 class="card-title text-xl mb-4">Event Details</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h3 class="font-semibold text-sm text-base-content/70 mb-1">Time</h3>
          <p class="text-base"><%= @event.time_range %></p>
        </div>

        <% if @event.location.present? %>
          <div>
            <h3 class="font-semibold text-sm text-base-content/70 mb-1">Location</h3>
            <p class="text-base"><%= @event.location %></p>
          </div>
        <% end %>

        <% if @event.duration_hours %>
          <div>
            <h3 class="font-semibold text-sm text-base-content/70 mb-1">Duration</h3>
            <p class="text-base"><%= @event.duration_hours %> hours</p>
          </div>
        <% end %>

        <% if @event.html_link.present? %>
          <div>
            <h3 class="font-semibold text-sm text-base-content/70 mb-1">Google Calendar</h3>
            <%= link_to "View in Google Calendar", @event.html_link, target: "_blank", class: "btn btn-xs btn-outline btn-info" %>
          </div>
        <% end %>
      </div>

      <% if @event.description.present? %>
        <div class="mt-6">
          <h3 class="font-semibold text-sm text-base-content/70 mb-2">Description</h3>
          <p class="text-base whitespace-pre-wrap"><%= @event.description %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>

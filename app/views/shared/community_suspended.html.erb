<div class="max-w-xl mx-auto py-16 text-center">
  <h1 class="text-2xl font-bold mb-4"><%= current_community.name %> is suspended</h1>
  <p class="text-base-content/70 mb-8">
    This community has been suspended, so its content is currently unavailable.
    If you think this is a mistake, please contact support.
  </p>
  <div class="flex justify-center gap-3">
    <%= button_to "Log out", logout_path, method: :delete, class: "btn btn-outline" %>
    <%= link_to "Delete my account", delete_account_path, class: "btn btn-ghost text-error" %>
  </div>
</div>

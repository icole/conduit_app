<%= turbo_frame_tag "dashboard-documents" do %>
<section>
  <div class="flex items-end justify-between pb-3 border-b border-base-content/80">
    <h3 class="text-2xl">Documents</h3>
    <%= link_to documents_path, class: "text-sm text-primary-ink font-medium hover:underline underline-offset-4", data: { turbo_frame: "_top" } do %>
      All docs →
    <% end %>
  </div>

  <% if @drive_files.any? %>
    <ol>
      <% @drive_files.each do |drive_file| %>
        <li class="border-b border-[var(--hairline)]">
          <%= link_to drive_file[:web_link], target: "_blank", rel: "noopener", class: "group block py-4", data: { turbo_frame: "_top" } do %>
            <p class="font-display text-lg leading-tight group-hover:underline underline-offset-4 decoration-1 truncate"><%= drive_file[:name] %></p>
            <% if drive_file[:updated_at].present? %>
              <p class="text-sm text-base-content/70 mt-1">Updated <%= time_ago_in_words(drive_file[:updated_at]) %> ago</p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="py-6 text-base-content/65">No documents yet.</p>
  <% end %>
</section>
<% end %>

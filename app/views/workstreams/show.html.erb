<% content_for :title, @workstream.name %>
<% can_manage = current_user.admin? || @workstream.owned_by?(current_user) %>

<div class="max-w-3xl mx-auto space-y-4">
  <%# The apps' top bar has a back button %>
  <%= link_to tasks_path(tab: "all"), class: "inline-flex items-center gap-1 text-sm text-base-content/70 hover:text-base-content native:hidden" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
    All work
  <% end %>

  <div class="card bg-base-100 border border-base-200 border-l-4 <%= workstream_accent_class(@workstream) %>">
    <div class="card-body p-4 sm:p-6 gap-3">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h1 class="text-xl sm:text-2xl font-bold"><%= @workstream.name %></h1>
          <div class="flex flex-wrap items-center gap-1.5 mt-2">
            <%= workstream_type_badge(@workstream) %>
            <%= workstream_priority_badge(@workstream) %>
            <% if @workstream.closed? %><span class="badge badge-sm badge-neutral">Closed</span><% end %>
          </div>
        </div>
        <% if @workstream.covered? %>
          <span class="badge badge-sm border-success text-success-ink whitespace-nowrap">Covered</span>
        <% else %>
          <span class="badge badge-sm badge-error whitespace-nowrap">Needs owner</span>
        <% end %>
      </div>

      <% if @workstream.description.present? %>
        <div data-workstream-description class="text-sm text-base-content/70 space-y-2">
          <%= simple_format(@workstream.description, {}, wrapper_tag: "p") %>
        </div>
      <% end %>

      <p class="text-sm">
        <% if @owners.any? %>
          <span class="text-base-content/70"><%= "Owner".pluralize(@owners.size) %>:</span> <%= @workstream.owner_names %>
        <% else %>
          <span class="text-error-ink">No owner assigned</span>
        <% end %>
      </p>

      <div class="flex flex-wrap gap-2">
        <% unless @workstream.closed? %>
          <%= link_to "+ Add task", new_task_path(workstream_id: @workstream.id), class: "btn btn-primary btn-sm", data: { turbo_frame: "_top" } %>
        <% end %>
        <% if current_user.admin? %>
          <%= link_to "Edit", edit_workstream_path(@workstream), class: "btn btn-ghost btn-sm" %>
        <% end %>
        <% if can_manage && @workstream.project? %>
          <% if @workstream.closed? %>
            <%= button_to "Reopen project", reopen_workstream_path(@workstream), method: :patch, class: "btn btn-ghost btn-sm", form: { data: { turbo_action: "replace" } } %>
          <% else %>
            <%= button_to "Close project", close_workstream_path(@workstream), method: :patch, class: "btn btn-ghost btn-sm", form: { data: { turbo_confirm: "Close this project? Its open tasks stay visible here.", turbo_action: "replace" } } %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @workstream.ongoing? || @recurring_tasks.any? %>
    <section>
      <div class="flex items-center justify-between mb-2">
        <h2 class="font-semibold">Recurring tasks <span class="text-base-content/65 text-sm font-normal"><%= @recurring_tasks.size %></span></h2>
      </div>
      <div class="space-y-2">
        <% @recurring_tasks.each do |recurring| %>
          <div id="<%= dom_id recurring %>" class="card bg-base-100 border border-base-200">
            <div class="card-body p-3 sm:p-4 flex-row items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="font-medium"><%= recurring.title %></p>
                <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
                  <%= @workstream.governance? ? required_badge : priority_badge(recurring.effective_priority) %>
                  <span class="badge badge-sm badge-ghost"><%= recurring.frequency_label %></span>
                  <%= effort_badge(recurring.estimated_minutes) %>
                </div>
                <p class="text-xs mt-2">
                  <% if recurring.responsibles.any? %>
                    <span class="text-base-content/70">Responsible:</span> <%= recurring.responsibles.map(&:name).to_sentence %>
                  <% else %>
                    <span class="<%= recurring.effective_priority == 'essential' ? 'text-error-ink' : 'text-base-content/70' %>">Nobody responsible yet</span>
                  <% end %>
                </p>
              </div>
              <% if recurring.manageable_by?(current_user) %>
                <%# Apps with a native top bar put the actions behind a ⋮ that opens a native sheet %>
                <div class="flex gap-1 shrink-0" data-controller="bridge--menu" data-bridge--menu-title-value="<%= recurring.title %>">
                  <button type="button" class="hidden bridge-button:inline-flex btn btn-ghost btn-sm btn-circle -mr-2 -mt-1" aria-label="More actions" data-action="bridge--menu#show">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                  </button>
                  <%# Apps without a native top bar show these as icons %>
                  <%= link_to edit_workstream_recurring_task_path(@workstream, recurring), class: "btn btn-ghost btn-xs native:btn-sm native:btn-square bridge-button:hidden", aria: { label: "Edit “#{recurring.title}”" }, data: { bridge__menu_target: "item", bridge_title: "Edit" } do %><span class="native:hidden">Edit</span><%= heroicon "pencil-square", variant: :outline, options: { class: "hidden native:block h-5 w-5" } %><% end %>
                  <%= button_to workstream_recurring_task_path(@workstream, recurring), method: :delete, class: "btn btn-ghost btn-xs text-error-ink native:btn-sm native:btn-square", form_class: "button_to bridge-button:hidden", aria: { label: "Remove “#{recurring.title}”" }, data: { bridge__menu_target: "item", bridge_title: "Remove", bridge_destructive: true }, form: { data: { turbo_confirm: "Remove this recurring task? Past instances are kept.", turbo_action: "replace" } } do %><span class="native:hidden">Remove</span><%= heroicon "trash", variant: :outline, options: { class: "hidden native:block h-5 w-5" } %><% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @recurring_tasks.empty? %>
          <p class="text-sm text-base-content/65">No recurring tasks yet. Use Add task and choose how often it repeats.</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <section>
    <h2 class="font-semibold mb-2">Open work <span id="open-work-count" class="text-base-content/65 text-sm font-normal"><%= @open_tasks.size %></span></h2>
    <div class="space-y-2">
      <% @open_tasks.each do |task| %>
        <div id="<%= dom_id task %>" class="card bg-base-100 border border-base-200">
          <div class="card-body p-3 sm:p-4 gap-2">
            <div class="flex items-start justify-between gap-3">
              <p class="font-medium min-w-0"><%= task.title %></p>
              <% if task.assignees.any? %>
                <span class="text-xs text-base-content/70 text-right"><%= task.assignees.map(&:name).to_sentence %></span>
              <% elsif task.released_by %>
                <span class="badge badge-sm badge-info whitespace-nowrap">Released by <%= task.released_by.name.split(" ").first %></span>
              <% else %>
                <span class="badge badge-sm badge-ghost whitespace-nowrap">Unclaimed</span>
              <% end %>
            </div>
            <div class="flex flex-wrap items-center gap-1.5">
              <%= task_priority_badge(task) %>
              <%= effort_badge(task.estimated_minutes) %>
              <% if task.due_date %><span class="badge badge-sm badge-ghost">Due <%= task.due_date.strftime("%b %-d") %></span><% end %>
              <% if can_manage || task.user_id == current_user.id || task.assigned_to?(current_user) %>
                <%# Apps with a native top bar put the actions behind a ⋮ that opens a native sheet %>
                <div class="ml-auto flex items-center gap-1" data-controller="bridge--menu" data-bridge--menu-title-value="<%= task.title %>">
                  <button type="button" class="hidden bridge-button:inline-flex btn btn-ghost btn-sm btn-circle -mr-2 -mt-1" aria-label="More actions" data-action="bridge--menu#show">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" /></svg>
                  </button>
                  <% if can_manage && task.assignees.empty? %>
                    <%# The apps assign from the edit sheet, which has the people picker %>
                    <%= link_to "Assign…", edit_task_path(task, return_to: workstream_path(@workstream)), class: "hidden", data: { bridge__menu_target: "item" } %>
                  <% end %>
                  <%= link_to edit_task_path(task, return_to: workstream_path(@workstream)), class: "btn btn-ghost btn-xs native:btn-sm native:btn-square bridge-button:hidden", aria: { label: "Edit “#{task.title}”" }, data: { bridge__menu_target: "item", bridge_title: "Edit" } do %><span class="native:hidden">Edit</span><%= heroicon "pencil-square", variant: :outline, options: { class: "hidden native:block h-5 w-5" } %><% end %>
                  <% if can_manage || task.user_id == current_user.id %>
                    <%= button_to task_path(task), method: :delete, class: "btn btn-ghost btn-xs text-error-ink native:btn-sm native:btn-square", form_class: "button_to bridge-button:hidden", aria: { label: "Delete “#{task.title}”" }, data: { bridge__menu_target: "item", bridge_title: "Delete", bridge_destructive: true },
                          form: { data: { turbo_confirm: task.recurring? ? "Delete this period's “#{task.title}”? The recurring task carries on." : "Delete “#{task.title}”?" } } do %><span class="native:hidden">Delete</span><%= heroicon "trash", variant: :outline, options: { class: "hidden native:block h-5 w-5" } %><% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if can_manage && task.assignees.empty? %>
              <%= form_with model: task, url: task_path(task, return_to: workstream_path(@workstream)), method: :patch, class: "flex gap-2 items-center bridge-button:hidden", data: { turbo_action: "replace" } do |form| %>
                <%= select_tag "task[assignee_ids][]", options_for_select(@users.map { |u| [ u.name, u.id ] }),
                      prompt: "Assign to…", id: "assign_#{task.id}", class: "select select-bordered select-sm flex-1 min-w-0", required: true,
                      aria: { label: "Assign #{task.title} to" } %>
                <%= form.submit "Assign", class: "btn btn-sm" %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
      <% if @open_tasks.empty? %>
        <p class="text-sm text-base-content/65">Nothing open right now.</p>
      <% end %>
    </div>
  </section>
</div>

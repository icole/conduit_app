<%= form_with(model: workstream, class: "space-y-4", data: { turbo: !legacy_ios_app? }) do |form| %>
  <% if workstream.errors.any? %>
    <div class="alert alert-error">
      <ul class="list-disc list-inside">
        <% workstream.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-control">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, class: "input input-bordered w-full", required: true, placeholder: "e.g. Garbage & Recycling Coordinator" %>
  </div>

  <div class="form-control">
    <%= form.label :description, "What it covers", class: "label" %>
    <%= form.text_area :description, rows: 3, class: "textarea textarea-bordered w-full" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-control">
      <%= form.label :workstream_type, "Type", class: "label" %>
      <%= form.select :workstream_type, Workstream::TYPES.map { |value, label| [ label, value ] }, {}, class: "select select-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= form.label :priority, class: "label" %>
      <%= form.select :priority, priority_options, {}, class: "select select-bordered w-full" %>
    </div>
  </div>

  <fieldset class="form-control">
    <legend class="label">Owners</legend>
    <p class="text-xs text-base-content/70 mb-2">Anyone listed can assign its work and close it. Leave everyone unticked if it needs an owner.</p>
    <%= hidden_field_tag "workstream[owner_ids][]", "" %>
    <div class="border border-base-300 rounded-box p-2 max-h-64 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 gap-1">
      <% User.order(:name).each do |user| %>
        <label class="flex items-center gap-2 p-2 rounded hover:bg-base-200 cursor-pointer">
          <%= check_box_tag "workstream[owner_ids][]", user.id, workstream.owner_ids.include?(user.id), id: "workstream_owner_#{user.id}", class: "checkbox checkbox-sm" %>
          <span><%= user.name %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="flex justify-end gap-2 pt-2">
    <%= link_to "Cancel", workstream.persisted? ? workstream_path(workstream) : tasks_path(tab: "coverage"), class: "btn btn-ghost" %>
    <%= form.submit workstream.persisted? ? "Save workstream" : "Create workstream", class: "btn btn-primary" %>
  </div>
<% end %>

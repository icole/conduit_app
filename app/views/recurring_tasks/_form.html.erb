<%= form_with(model: [ workstream, recurring_task ], class: "space-y-4", data: { turbo: !legacy_ios_app? }) do |form| %>
  <% if recurring_task.errors.any? %>
    <div class="alert alert-error">
      <ul class="list-disc list-inside">
        <% recurring_task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-control">
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, class: "input input-bordered w-full", required: true, placeholder: "e.g. Take out garbage & recycling" %>
  </div>

  <div class="form-control">
    <%= form.label :description, class: "label" %>
    <%= form.text_area :description, rows: 2, class: "textarea textarea-bordered w-full" %>
  </div>

  <div class="form-control">
    <%= render "tasks/people_select", name: "recurring_task[responsible_ids][]", id: "recurring_task_responsible_ids",
               selected: recurring_task.responsibles.to_a, users: @responsible_choices,
               label: "Responsible each period", empty_label: "Nobody yet (coverage gap)" %>
    <p class="text-xs text-base-content/70 -mt-2">Each period's task goes to everyone picked. Anyone can drop out of a single period if they're away.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-controller="due-weekday">
    <div class="form-control">
      <%= form.label :frequency, class: "label" %>
      <%= form.select :frequency, RecurringTask::FREQUENCIES.map { |value, label| [ label, value ] }, {}, class: "select select-bordered w-full",
            data: { due_weekday_target: "frequency", action: "change->due-weekday#toggle" } %>
    </div>

    <div class="form-control" data-due-weekday-target="field">
      <%= form.label :due_wday, "Due on", class: "label" %>
      <%= form.select :due_wday, due_weekday_options, {}, class: "select select-bordered w-full" %>
    </div>

    <div class="form-control">
      <%= form.label :priority, class: "label" %>
      <%= form.select :priority, priority_options(include_inherit: true), {}, class: "select select-bordered w-full" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-control">
      <%= form.label :effort, "Estimated effort", class: "label" %>
      <%= form.select :effort, EstimatedEffort::SIZES.keys, {}, class: "select select-bordered w-full", required: true %>
      <p class="text-xs text-base-content/70 mt-1">The size the group agrees this job is. It's what counts toward contribution, however long it actually takes.</p>
    </div>

    <div class="form-control">
      <%= form.label :starts_on, "First period starts", class: "label" %>
      <%= form.date_field :starts_on, class: "input input-bordered w-full" %>
    </div>
  </div>

  <div class="flex justify-end gap-2 pt-2">
    <%= link_to "Cancel", workstream_path(workstream), class: "btn btn-ghost bridge-button:hidden" %>
    <%= form.submit recurring_task.persisted? ? "Save recurring task" : "Add recurring task", class: "btn btn-primary bridge-button:w-full bridge-button:h-12 bridge-button:text-base" %>
  </div>
<% end %>

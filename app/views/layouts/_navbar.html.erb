<%# Top bar. On a phone it's just the logo, bell and you; the sections live in
    the tab bar at the bottom (layouts/tab_bar), within reach of a thumb. %>
<header class="sticky top-0 z-40 border-b border-[var(--hairline)] bg-paper/85 backdrop-blur-md backdrop-saturate-150">
  <div class="max-w-7xl mx-auto h-14 lg:h-16 px-4 sm:px-6 lg:px-8 flex items-center gap-8">
    <%= link_to root_path, class: "shrink-0 flex items-center" do %>
      <%= image_tag("crow-woods-logo.png", alt: current_community&.name || "Conduit", class: "h-8 lg:h-9 w-auto") %>
    <% end %>

    <% if user_signed_in? %>
      <nav aria-label="Main" class="hidden lg:flex items-center gap-7 flex-1">
        <%= section_link_to "Home", dashboard_index_path, :home, class: "nav-link" %>
        <%= section_link_to "Meals", meals_path, :meals, class: "nav-link" %>
        <%= section_link_to "Tasks", tasks_path, :tasks, class: "nav-link" %>
        <%= section_link_to "Calendar", calendar_index_path, :calendar, class: "nav-link" %>
        <%= section_link_to "Docs", documents_path, :docs, class: "nav-link" %>
        <% if current_community&.chat_available? %>
          <%= section_link_to "Chat", chat_index_path, :chat, class: "nav-link" %>
        <% end %>

        <% if current_user.admin? %>
          <div class="dropdown dropdown-hover">
            <div tabindex="0" role="button" class="nav-link flex items-center gap-1" <%= 'aria-current="page"'.html_safe if current_section == :admin %>>
              Admin
              <%= heroicon "chevron-down", variant: :outline, options: { class: "h-3.5 w-3.5" } %>
            </div>
            <ul tabindex="0" class="dropdown-content menu z-50 w-52 rounded-box bg-base-100 p-2 shadow-lg border border-[var(--hairline)]">
              <li><%= link_to "Invitations", invitations_path %></li>
              <li><%= link_to "Users", users_path %></li>
              <li><%= link_to "Households", households_path %></li>
              <li><%= link_to "Monthly Dues", dues_path %></li>
              <li><%= link_to "Email Logs", email_logs_path %></li>
              <% if current_user.super_admin? %>
                <li><%= link_to "Communities", admin_communities_path %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </nav>

      <div class="ml-auto flex items-center gap-1">
        <%= render "notifications/bell" %>
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-ghost btn-circle p-0" aria-label="Account menu">
            <%= user_avatar(current_user, size: "w-9", text: "text-sm") %>
          </div>
          <ul tabindex="0" class="menu dropdown-content z-50 mt-2 w-56 rounded-box bg-base-100 p-2 shadow-lg border border-[var(--hairline)]">
            <li class="menu-title text-base-content/70"><%= current_user.name %></li>
            <li><%= link_to account_path do %>
              Account Settings
              <% unless google_account? %>
                <span class="badge badge-warning badge-xs">Limited</span>
              <% end %>
            <% end %></li>
            <li><%= button_to "Logout", logout_path, method: :delete, class: "w-full text-left", form_class: "w-full" %></li>
          </ul>
        </div>
      </div>
    <% end %>
  </div>
</header>

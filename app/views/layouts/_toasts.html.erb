<%# Where messages appear: the bottom of the screen, full width (with margins)
    on phones and centred on wider screens. In the apps, the top: iOS 26's
    tab bar floats over the bottom of the page, and the top bar is solid. Turbo Streams update #flash and
    #undo-notification-container; a Turbo Frame (the Tasks tabs) renders its
    own copy without the ids, since the layout's stays on the page.
    locals: ids (default true) %>
<% ids = local_assigns.fetch(:ids, true) %>
<div <%= "id=toasts" if ids %> class="fixed inset-x-0 z-50 pointer-events-none flex flex-col items-center gap-2 px-4 <%= hotwire_native_app? ? 'top-0 pt-4' : 'bottom-0 pb-[max(1rem,env(safe-area-inset-bottom))]' %>">
  <%= tag.div id: (ids ? "flash" : nil), class: "w-full max-w-lg flex flex-col gap-2 empty:hidden" do %><%= render "layouts/flash_messages" %><% end %>
  <%= tag.div id: (ids ? "undo-notification-container" : nil), class: "w-full max-w-lg empty:hidden" do %><%= render "layouts/undo_notification" %><% end %>
</div>

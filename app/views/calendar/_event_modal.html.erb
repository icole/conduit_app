<%# One event's popup on the calendar. It's the only place an event is shown.
    locals: event, modal_id %>
<dialog id="<%= modal_id %>" class="modal">
  <div class="modal-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>

    <div class="flex items-center gap-3 mb-4">
      <% if event.respond_to?(:all_day) && event.all_day %>
        <div class="w-4 h-4 bg-info rounded-full flex-shrink-0"></div>
        <h3 class="font-bold text-lg text-info-ink">All Day</h3>
      <% else %>
        <div class="w-4 h-4 bg-success rounded-full flex-shrink-0"></div>
        <h3 class="font-bold text-lg text-success">
          <%= event.start_time.strftime('%l:%M %p').strip %>
          <% if event.end_time && event.start_time.to_date == event.end_time.to_date %>
            - <%= event.end_time.strftime('%l:%M %p').strip %>
          <% end %>
        </h3>
      <% end %>
    </div>

    <div class="space-y-4">
      <div>
        <h4 class="font-semibold text-xl mb-2"><%= event.title %></h4>
      </div>

      <div class="flex items-center gap-2 text-base-content/70">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
        </svg>
        <span><%= event.time_range %></span>
      </div>

      <% if event.location.present? %>
        <div class="flex items-start gap-2 text-base-content/70">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
          <span class="flex-1"><%= event.location %></span>
        </div>
      <% end %>

      <% if event.description.present? %>
        <p class="text-base-content/80 whitespace-pre-wrap" data-event-description><%= event.description %></p>
      <% end %>

      <div class="divider"></div>

      <div class="flex items-center gap-2 text-sm text-base-content/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>Google Calendar Event</span>
      </div>

      <div class="divider"></div>

      <div class="flex justify-end gap-3">
        <%= link_to edit_calendar_event_path(google_event_id: event.google_event_id), class: "btn btn-secondary btn-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
          </svg>
          Edit
        <% end %>
        <%= link_to calendar_event_path(google_event_id: event.google_event_id),
                    class: "btn btn-error btn-sm",
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure you want to delete this event? This will also remove it from Google Calendar."
                    } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          Delete
        <% end %>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

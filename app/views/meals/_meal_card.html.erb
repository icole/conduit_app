<%
  is_today = meal.scheduled_date == Date.current
  is_tomorrow = meal.scheduled_date == Date.current.tomorrow
  needs_cook = meal.needs_head_cook?
  user_is_cook = meal.user_is_cook?(current_user)
  user_attending = meal.user_attending?(current_user)
  user_maybe = meal.user_maybe?(current_user)
  user_declined = meal.user_declined?(current_user)
  user_late_plate = meal.user_late_plate?(current_user)
  rsvps_open = meal.rsvps_open?
  native_app = hotwire_native_app? rescue false

  card_state = "opacity-60" if meal.cancelled?
%>

<% if native_app %>
  <%= link_to meal_path(meal), id: "meal_#{meal.id}", class: "block px-4 py-3 border-b border-base-200 last:border-b-0 active:bg-base-200/60" do %>
    <div class="flex items-center gap-3">
      <div class="text-center min-w-10 <%= needs_cook ? 'text-warning-ink' : (is_today ? 'text-primary-ink' : '') %>">
        <div class="font-display text-2xl leading-none"><%= meal.scheduled_at.day %></div>
        <div class="text-xs text-base-content/60 uppercase"><%= meal.scheduled_at.strftime("%b") %></div>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <span class="font-medium">
            <% if is_today %>Today<% elsif is_tomorrow %>Tomorrow<% else %><%= meal.scheduled_at.strftime("%A") %><% end %>
          </span>
          <span class="text-sm text-base-content/60"><%= meal.time_display %></span>
        </div>
        <div class="text-sm text-base-content/60 mt-0.5 truncate">
          <% head_cook = meal.meal_cooks.find { |mc| mc.head_cook? } %>
          <% if head_cook %>
            Cook: <%= head_cook.user.name.split.first %>
          <% elsif needs_cook %>
            <span class="text-warning-ink">Needs cook!</span>
          <% end %>
          <% if meal.menu.present? %>
            · <%= truncate(meal.menu.to_plain_text, length: 30) %>
          <% end %>
        </div>
      </div>
      <div class="flex flex-col items-end gap-0.5">
        <% if meal.cancelled? %>
          <span class="badge badge-sm border-0 font-medium bg-error/15 text-error-ink">Cancelled</span>
        <% elsif user_is_cook %>
          <span class="badge badge-sm border-0 font-medium bg-success/15 text-success-ink">Cooking</span>
        <% elsif user_attending %>
          <span class="badge badge-sm border-0 font-medium bg-info/15 text-info-ink">Going</span>
        <% elsif user_maybe %>
          <span class="badge badge-sm border-0 font-medium bg-warning/20 text-warning-ink">Maybe</span>
        <% elsif user_late_plate %>
          <span class="badge badge-sm border-0 font-medium bg-secondary/15 text-secondary-ink">Late Plate</span>
        <% elsif user_declined %>
          <span class="badge badge-sm border-0 font-medium bg-base-200 text-base-content/60">Declined</span>
        <% end %>
        <%# Head count, labelled so a bare number reads %>
        <span class="text-xs text-base-content/65">
          <%= meal.total_attendees %> going<% if meal.guests_count > 0 %><span class="text-base-content/65"> (+<%= meal.guests_count %>)</span><% end %>
        </span>
        <% if meal.late_plate_count > 0 %>
          <span class="badge badge-secondary badge-xs"><%= meal.late_plate_count %> late</span>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
<%= link_to meal_path(meal), id: "meal_#{meal.id}", class: "card bg-base-100 lift #{card_state}" do %>
  <div class="card-body p-5 gap-0">
    <!-- Header: Date, Time, Status -->
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-3">
        <div class="text-center min-w-12 leading-none <%= is_today ? 'text-secondary-ink' : '' %>">
          <div class="font-display text-4xl tracking-[-0.04em]"><%= meal.scheduled_at.day %></div>
          <div class="eyebrow text-[0.6875rem] text-base-content/70 mt-1"><%= meal.scheduled_at.strftime("%b") %></div>
        </div>
        <div>
          <div class="font-display text-xl leading-tight">
            <% if is_today %>
              Today
            <% elsif is_tomorrow %>
              Tomorrow
            <% else %>
              <%= meal.scheduled_at.strftime("%A") %>
            <% end %>
          </div>
          <div class="text-sm text-base-content/70"><%= meal.time_display %></div>
        </div>
      </div>
      <div class="flex flex-col items-end gap-1">
        <% if meal.cancelled? %>
          <div class="badge badge-error badge-sm">Cancelled</div>
        <% elsif !rsvps_open %>
          <div class="badge badge-warning badge-sm">RSVPs Closed</div>
        <% end %>
        <% if user_is_cook %>
          <div class="badge badge-success badge-sm">Cooking</div>
        <% elsif user_attending %>
          <div class="badge badge-info badge-sm">Going</div>
        <% elsif user_maybe %>
          <div class="badge badge-warning badge-sm">Maybe</div>
        <% elsif user_late_plate %>
          <div class="badge badge-secondary badge-sm">Late Plate</div>
        <% elsif user_declined %>
          <div class="badge badge-ghost badge-sm opacity-60">Declined</div>
        <% end %>
      </div>
    </div>

    <!-- Cooks -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 text-sm">
      <% head_cook = meal.meal_cooks.find { |mc| mc.head_cook? } %>
      <% helpers = meal.meal_cooks.reject { |mc| mc.head_cook? } %>
      <% if head_cook %>
        <span><span class="text-base-content/60">Cook:</span> <%= head_cook.user.name.split.first %></span>
      <% elsif needs_cook %>
        <span class="font-medium text-secondary-ink">Needs a cook</span>
      <% end %>
      <% if helpers.any? %>
        <span><span class="text-base-content/60">Helpers:</span> <%= helpers.map { |mc| mc.user.name.split.first }.join(', ') %></span>
      <% end %>
      <% if meal.cooks.empty? %>
        <span class="text-base-content/70">and helpers</span>
      <% end %>
    </div>

    <!-- Menu (if present) -->
    <% if meal.menu.present? %>
      <div class="text-sm text-base-content/70 mt-2 line-clamp-2">
        <span class="font-medium">Menu:</span> <%= meal.menu.to_plain_text %>
      </div>
    <% end %>

    <!-- Footer: Attendees count and actions -->
    <div class="flex items-center justify-between mt-4 pt-3 border-t border-[var(--hairline)]">
      <div class="text-sm text-base-content/60">
        <span class="font-medium text-base-content"><%= meal.total_attendees %></span> attending<% if meal.guests_count > 0 %><span class="text-base-content/65"> (+<%= meal.guests_count %> guests)</span><% end %><% if meal.late_plate_count > 0 %><span class="badge badge-secondary badge-sm ml-2"><%= meal.late_plate_count %> late</span><% end %>
      </div>
      <% if !meal.cancelled? && rsvps_open && !user_is_cook && !user_attending && !user_maybe && !user_late_plate && !user_declined %>
        <span class="btn btn-primary btn-sm rounded-full px-4">RSVP</span>
      <% end %>
    </div>
  </div>
<% end %>
<% end %>

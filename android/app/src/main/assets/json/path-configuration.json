{
  "settings": {
    "screenshots_enabled": true
  },
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["/calendar_events/new$", "/calendar_events/[^/]+/edit$"],
      "properties": {
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": ["/new(\\?.*)?$", "/edit(\\?.*)?$"],
      "properties": {
        "uri": "hotwire://fragment/web_modal",
        "context": "modal"
      }
    },
    {
      "patterns": ["/notifications(\\?.*)?$"],
      "properties": {
        "uri": "hotwire://fragment/web_modal",
        "context": "modal"
      }
    },
    {
      "patterns": ["/meals/[^/]+/(reschedule|cook|rsvp)(\\?.*)?$", "/dues/settings(\\?.*)?$", "/account/delete(\\?.*)?$"],
      "properties": {
        "uri": "hotwire://fragment/web_modal",
        "context": "modal"
      }
    },
    {
      "patterns": ["/documents/[^/]+/edit$"],
      "properties": {
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false,
        "context": "default"
      }
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, for every host. Debug builds swap in
     src/debug/res/xml/network_security_config.xml to reach a dev server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
